# ─── Screeps Telemetry Collection Configuration ───────────────────
# Copy to .env and fill in your values.
# For official server, set SCREEPS_TOKEN.
# For private server, set SCREEPS_HOST (and optionally PORT, USERNAME, PASSWORD).

# ─── Official Server (MMO) ─────────────────────────────────────────
# Get your API token from: https://screeps.com/a/#!/account/auth
# SCREEPS_TOKEN=your-api-token-here
# SCREEPS_SHARD=shard3

# ─── Private Server ─────────────────────────────────────────────────
# Uncomment and fill for private server. Comment out SCREEPS_TOKEN/SHARD.
# SCREEPS_HOST=127.0.0.1
# SCREEPS_PORT=21025
# SCREEPS_PROTOCOL=http
# SCREEPS_USERNAME=your-username
# SCREEPS_PASSWORD=your-password

# ─── Private Server Docker ──────────────────────────────────────────
# 私服配置在 docker/ 目录下，cd docker && docker compose up -d 启动
# Container name and CLI port for tools/private/screeps-cli.js
# SCREEPS_CONTAINER=screeps-server
# SCREEPS_CLI_PORT=21026
# SCREEPS_MONGO_CONTAINER=screeps-mongo

# ─── Output Configuration ──────────────────────────────────────────
# collect-telemetry.js output file (JSONL format)
# OUTPUT_FILE=./data/telemetry.jsonl

# export-segments.js output directory and polling interval
# EXPORT_DIR=./data/export
# EXPORT_INTERVAL=300000
