{
  "name": "screeps-world-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Extensible TypeScript framework for Screeps: World",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit && rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --testTimeout=60000",
    "test:e2e": "npm run build && npx vitest run tests/e2e --config vitest.e2e.config.ts",
    "test:e2e:smoke": "npm run build && npx vitest run tests/e2e/scenarios/00-smoke.test.ts --config vitest.e2e.config.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": "bash -c 'tsc --noEmit'"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@screeps/driver": "^5.3.0",
    "@types/node": "^22.10.2",
    "@types/screeps": "^3.3.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "rollup": "^4.30.1",
    "screeps-server-mockup": "github:screepers/screeps-server-mockup",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
