{
  "name": "screeps-world-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Extensible TypeScript framework for Screeps: World",
  "main": "dist/main.js",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration/scenarios tests/integration/edge-cases --testTimeout=60000",
    "test:unit": "vitest run --exclude 'tests/integration/**'"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.2",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.10.2",
    "@types/screeps": "^3.3.8",
    "rollup": "^4.30.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
