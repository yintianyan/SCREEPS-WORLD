# ─── Screeps 私服环境变量模板 ──────────────────────────────────
# 复制为 .env 后填入实际值：cp .env.example .env

# Steam API Key（可选，用于 Steam 认证模式；留空则使用密码认证）
STEAM_KEY=

# screepsmod-map-tool 管理员凭据
MAPTOOL_USER=admin
MAPTOOL_PASS=admin

# 浏览器客户端：Steam 官方 package.nw 路径
# macOS Steam 默认路径如下；Windows / Linux 请按实际路径填写
SCREEPS_CLIENT_PACKAGE=/Users/songhao/Library/Application Support/Steam/steamapps/common/Screeps/package.nw
